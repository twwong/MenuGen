# Creator workflow. Keep false until the protected preview is provisioned and
# passes acceptance testing.
CREATOR_WORKFLOW_ENABLED=false
# CREATOR_BACKEND=fixture

# Public application and Clerk browser configuration.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-only persistence and authentication.
# DATABASE_URL=
# CLERK_SECRET_KEY=
# DRAFT_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Separate private Vercel Blob stores.
# SOURCE_BLOB_READ_WRITE_TOKEN=
# RESULT_BLOB_READ_WRITE_TOKEN=

# Upload verification and normalization.
# TRANSLOADIT_KEY=
# TRANSLOADIT_SECRET=

# Anonymous rolling rate limits.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Content-free completion email.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=MenuGen <onboarding@resend.dev>

# AI pipeline. Also required for the explicitly confirmed live benchmark.
# OPENAI_API_KEY=
# EXTRACTION_MODEL=gpt-5.6-terra
# IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08

# Generation safety controls.
# GENERATION_CONCURRENCY=4
# GENERATION_MAX_RETRIES=2
# GENERATION_COST_WARNING_USD=1.50
# GENERATION_COST_HARD_LIMIT_USD=2.00
